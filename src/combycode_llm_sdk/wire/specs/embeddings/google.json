{
  "id": "google/embeddings",
  "provider": "google", "api": "embeddings",
  "_note": "Google embeds ONE input per request, so the adapter loops. This spec describes a single call; its input context is {model, text}.",
  "envelope": {
    "method": "POST",
    "url": { "$join": [{ "$config": "baseURL" }, "/v1beta/", { "$call": "googleModelPath" }, ":embedContent"] },
    "headers": [
      { "name": "x-goog-api-key", "value": { "$config": "apiKey" } },
      { "name": "content-type", "value": "application/json" }
    ]
  },
  "blocks": [
    { "name": "model", "to": "model", "template": { "$call": "googleModelPath" } },
    { "name": "content", "to": "content", "template": { "parts": [{ "text": { "$": "text" } }] } }
  ]
}

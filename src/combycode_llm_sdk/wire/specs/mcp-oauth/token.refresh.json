{
  "id": "mcp-oauth/token.refresh",
  "extends": "mcp-oauth/base",
  "envelope": {
    "method": "POST",
    "url": {
      "$": "tokenEndpoint"
    },
    "bodyKind": "form",
    "headers": [
      {
        "name": "content-type",
        "value": "application/x-www-form-urlencoded"
      }
    ]
  },
  "fields": [
    {
      "from": "grant_type",
      "to": "grant_type",
      "default": "refresh_token"
    },
    {
      "from": "refresh_token",
      "to": "refresh_token"
    },
    {
      "from": "client_id",
      "to": "client_id"
    },
    {
      "from": "client_secret",
      "to": "client_secret",
      "presence": "truthy"
    },
    {
      "_note": "RFC 8707. The exchange has always sent it and the refresh did not, so an authorization server that scopes tokens per resource handed back a refreshed token scoped to nothing -- and the retry 401s with a token that looks valid.",
      "from": "resource",
      "to": "resource",
      "presence": "truthy"
    }
  ]
}

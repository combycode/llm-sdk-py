{
  "id": "openai/retrieval.attachDocument",
  "extends": "openai/retrieval.json",
  "envelope": {
    "method": "POST",
    "url": {
      "$join": [
        {
          "$config": "baseURL"
        },
        "/v1/vector_stores/",
        {
          "$": "corpusId"
        },
        "/files"
      ]
    }
  },
  "fields": [
    {
      "from": "fileId",
      "to": "file_id"
    },
    {
      "from": "metadata",
      "to": "attributes",
      "presence": "truthy"
    }
  ]
}

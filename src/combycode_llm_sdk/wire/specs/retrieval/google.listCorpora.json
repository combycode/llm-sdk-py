{
  "id": "google/retrieval.listCorpora",
  "extends": "google/retrieval.json",
  "envelope": {
    "method": "GET",
    "bodyKind": "none",
    "url": {
      "$join": [
        {
          "$config": "baseURL"
        },
        "/v1beta/fileSearchStores"
      ]
    },
    "query": [
      {
        "name": "pageSize",
        "value": 20,
        "_note": "API cap"
      },
      {
        "name": "pageToken",
        "value": {
          "$": "pageToken"
        },
        "when": {
          "truthy": "pageToken"
        }
      }
    ]
  }
}

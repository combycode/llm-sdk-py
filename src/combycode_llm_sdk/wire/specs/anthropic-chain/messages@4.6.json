{
  "id": "anthropic/messages@4.6",
  "extends": "anthropic/messages@4.1",
  "_note": "Adaptive thinking replaces the token budget. budget_tokens is rejected from here on.",
  "removeBlocks": [
    "thinking.budgeted"
  ],
  "blocks": [
    {
      "name": "thinking.adaptive",
      "when": {
        "all": [
          {
            "truthy": "thinking"
          },
          {
            "ne": [
              "thinking.mode",
              "off"
            ]
          },
          {
            "_note": "`between_tools` is its OWN thinking type, not an adaptive variant -- the two are siblings in ThinkingConfigParam and sending both would be one field with two shapes.",
            "ne": [
              "thinking.mode",
              "between_tools"
            ]
          }
        ]
      },
      "to": "thinking",
      "template": {
        "type": "adaptive",
        "display": {
          "$when": {
            "eq": [
              "thinking.visibility",
              "hidden"
            ]
          },
          "$value": "omitted"
        }
      }
    },
    {
      "name": "thinking.adaptive.effort",
      "when": {
        "all": [
          {
            "truthy": "thinking"
          },
          {
            "ne": [
              "thinking.mode",
              "off"
            ]
          },
          {
            "truthy": "thinking.effort"
          }
        ]
      },
      "to": "output_config",
      "merge": true,
      "template": {
        "effort": {
          "$": "thinking.effort"
        }
      }
    },
    {
      "_note": "MODEL-GATED, and the gate is the catalog, not this spec: claude-sonnet-5.5 and six models that REFUSE between_tools all pin to messages@4.7, so a spec cannot tell them apart. `LLMClient` drops the mode before the build when the catalog does not record the model as accepting it.",
      "name": "thinking.betweenTools",
      "when": {
        "eq": [
          "thinking.mode",
          "between_tools"
        ]
      },
      "to": "thinking",
      "template": {
        "type": "between_tools"
      }
    }
  ],
  "placeBlocks": {
    "thinking.adaptive": {
      "before": "structured"
    },
    "thinking.adaptive.effort": {
      "before": "structured"
    }
  }
}

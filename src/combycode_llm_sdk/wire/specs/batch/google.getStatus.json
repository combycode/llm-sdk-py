{
  "id": "google/batch.getStatus",
  "provider": "google",
  "api": "batch",
  "envelope": {
    "method": "GET",
    "bodyKind": "none",
    "url": {
      "$join": [
        {
          "$config": "baseURL"
        },
        "/v1beta/",
        {
          "$": "batchId"
        }
      ]
    },
    "headers": [
      {
        "name": "x-goog-api-key",
        "value": {
          "$config": "apiKey"
        }
      }
    ]
  },
  "_note": "Auth is the x-goog-api-key HEADER, never ?key= in the URL: a key in a query string is copied into every access log and telemetry span the request passes through."
}

{
  "id": "openai/chat-completions",
  "provider": "openai",
  "api": "chat-completions",
  "flavors": [
    "openai",
    "xai",
    "openrouter"
  ],
  "tables": {
    "reasoningEffort": {
      "_note": "Our vocabulary -> theirs. `max` means 'the most this model will do' and is MAPPED, never sent: measured 2026-09-30, both OpenAI and xAI answer 400 to `effort: \"max\"`, and OpenAI names the value in the message. Their ladder tops out at xhigh, so that is what max means here -- Google's table maps it to `high` for the same reason, its own ladder ending there.",
      "low": "low",
      "medium": "medium",
      "high": "high",
      "max": "xhigh",
      "xhigh": "xhigh"
    }
  },
  "fields": [
    {
      "from": "model",
      "to": "model"
    },
    {
      "from": "maxTokens",
      "to": "max_completion_tokens",
      "default": 4096
    },
    {
      "from": "temperature",
      "to": "temperature"
    },
    {
      "from": "topP",
      "to": "top_p"
    },
    {
      "from": "seed",
      "to": "seed"
    },
    {
      "from": "topK",
      "to": "top_k",
      "when": {
        "not": {
          "flavor": "openai"
        }
      },
      "note": "OpenAI has no top_k; the OpenAI-compatible backends do"
    },
    {
      "from": "presencePenalty",
      "to": "presence_penalty"
    },
    {
      "from": "frequencyPenalty",
      "to": "frequency_penalty"
    },
    {
      "from": "stop",
      "to": "stop",
      "presence": "truthy"
    },
    {
      "from": "serviceTier",
      "to": "service_tier",
      "presence": "truthy",
      "call": "openaiTier"
    }
  ],
  "blocks": [
    {
      "name": "messages",
      "call": "openaiChatMessages",
      "to": "messages"
    },
    {
      "name": "moderation",
      "when": {
        "pred": "wantsNativeModeration"
      },
      "to": "moderation",
      "template": {
        "$call": "nativeModeration"
      }
    },
    {
      "name": "promptCacheOptions",
      "when": {
        "all": [
          {
            "flavor": "openai"
          },
          {
            "truthy": "providerOptions.promptCacheOptions"
          }
        ]
      },
      "to": "prompt_cache_options",
      "template": {
        "$": "providerOptions.promptCacheOptions"
      }
    },
    {
      "name": "audio",
      "_note": "Fires for audio IN or audio OUT. It was `hasAudioInput` alone, so `outputModalities: ['text','audio']` reached the request object and was dropped here: gpt-audio then refused the call with 'This model requires that either input content or output modality contain audio'. The parser has always built an audio_output part from `message.audio`, so both ends of the audio-output path existed and only this guard kept them apart.",
      "when": {
        "any": [
          {
            "pred": "hasAudioInput"
          },
          {
            "includes": [
              "outputModalities",
              "audio"
            ]
          }
        ]
      },
      "template": {
        "modalities": [
          "text",
          "audio"
        ],
        "audio": {
          "voice": {
            "$call": "resolveVoiceOpenAI"
          },
          "format": {
            "$call": "openaiAudioFormat"
          }
        }
      }
    },
    {
      "name": "tools",
      "when": {
        "truthy": "tools"
      },
      "to": "tools",
      "template": {
        "$map": "tools",
        "$dropUnmatched": true,
        "$case": [
          {
            "when": {
              "isFunctionTool": true
            },
            "value": {
              "type": "function",
              "function": {
                "name": {
                  "$": "@name"
                },
                "description": {
                  "$": "@description"
                },
                "parameters": {
                  "$call": "openaiToolParams",
                  "$arg": {
                    "$": "@"
                  }
                },
                "strict": {
                  "$when": {
                    "itemTruthy": "strict"
                  },
                  "$value": true
                }
              }
            }
          }
        ]
      }
    },
    {
      "name": "toolChoice.keyword",
      "when": {
        "all": [
          {
            "truthy": "toolChoice"
          },
          {
            "pred": "toolChoiceIsString"
          }
        ]
      },
      "to": "tool_choice",
      "template": {
        "$": "toolChoice"
      }
    },
    {
      "name": "toolChoice.named",
      "when": {
        "all": [
          {
            "truthy": "toolChoice"
          },
          {
            "not": {
              "pred": "toolChoiceIsString"
            }
          }
        ]
      },
      "to": "tool_choice",
      "template": {
        "type": "function",
        "function": {
          "name": {
            "$": "toolChoice.name"
          }
        }
      }
    },
    {
      "name": "reasoning",
      "when": {
        "all": [
          {
            "truthy": "thinking"
          },
          {
            "ne": [
              "thinking.mode",
              "off"
            ]
          }
        ]
      },
      "_note": "chat-completions takes `reasoning_effort`, a top-level STRING. This block used to build `reasoning: {effort}` -- the RESPONSES shape -- and OpenAI answers 400 `Unknown parameter: 'reasoning'` to it (measured 2026-09-30), so asking for thinking on this surface failed every time. xAI hid the same bug behind an overlay that deleted the field outright.",
      "to": "reasoning_effort",
      "template": { "$table": "reasoningEffort", "$key": "thinking.effort", "$default": "medium" }
    },
    {
      "name": "structured",
      "when": {
        "truthy": "structured"
      },
      "to": "response_format",
      "template": {
        "type": "json_schema",
        "json_schema": {
          "name": {
            "$": "structured.name",
            "$default": "response"
          },
          "schema": {
            "$call": "openaiStructuredSchema"
          },
          "strict": {
            "$call": "openaiStructuredStrict"
          }
        }
      }
    }
  ],
  "overlays": {
    "xai": {
      "ops": [
        {
          "op": "rename",
          "from": "max_completion_tokens",
          "to": "max_tokens",
          "_note": "xAI uses max_tokens on this API"
        },
        {
          "op": "delete",
          "from": "reasoning_effort",
          "when": { "not": { "pred": "xaiTakesReasoning" } },
          "_note": "The note here used to read 'xAI reasoning is a model variant, not a parameter' and the delete was unconditional. Measured 2026-09-30 on /v1/chat/completions: grok-4.6 honours `reasoning_effort` (low 927/728 -> xhigh 7043/18081 reasoning tokens, ranges disjoint), so the claim was wrong for the 4.3+ line. grok-4.20 refuses the parameter by name on this surface too, which is what the predicate still deletes for."
        }
      ]
    },
    "openrouter": {
      "ops": [
        {
          "op": "rename",
          "from": "max_completion_tokens",
          "to": "max_tokens"
        },
        {
          "op": "call",
          "call": "openrouterOnline",
          "_note": "web_search becomes a :online model suffix; structural, so code"
        },
        {
          "op": "mergeFrom",
          "from": "providerOptions.openrouter",
          "_note": "routing options merged into the body root"
        },
        {
          "op": "rename",
          "from": "reasoning_effort",
          "to": "reasoning.effort",
          "_note": "OpenRouter keeps the OBJECT form. Probed 2026-09-30 on openai/gpt-5.4-nano: it accepts `reasoning: {effort}` AND `reasoning_effort`, and honours both -- but the object is the shape OpenRouter documents, and the only one that can also carry its own `max_tokens` and `exclude`. The base spec moved to `reasoning_effort` because OpenAI chat-completions answers 400 `Unknown parameter: 'reasoning'`; that is an OpenAI fact, not an OpenRouter one, so the shape is restored here rather than imposed on a third provider."
        }
      ]
    }
  },
  "_note": "Unversioned for the same reason as openai/responses: the shape does not vary by model, only by flavor."
}

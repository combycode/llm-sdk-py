{
  "id": "openai/responses",
  "provider": "openai",
  "api": "responses",
  "flavors": [
    "openai",
    "xai",
    "openrouter"
  ],
  "tables": {
    "summaryByVisibility": {
      "full": "auto",
      "summary": "concise"
    },
    "reasoningEffort": {
      "_note": "Our vocabulary -> theirs. `max` means 'the most this model will do' and is MAPPED, never sent: measured 2026-09-30, OpenAI and xAI both answer 400 to `effort: \"max\"` -- OpenAI names the value (\"Unsupported value: 'max' is not supported\"). Their ladder tops out at xhigh, so max means xhigh here; Google's table maps it to `high` because its own ladder ends there. A model that does not take xhigh answers 400 naming the value, the same honest outcome an access-controlled service tier gets.",
      "low": "low",
      "medium": "medium",
      "high": "high",
      "max": "xhigh",
      "xhigh": "xhigh"
    }
  },
  "fields": [
    {
      "from": "model",
      "to": "model"
    },
    {
      "from": "system",
      "to": "instructions",
      "presence": "truthy"
    },
    {
      "from": "previousResponseId",
      "to": "previous_response_id",
      "presence": "truthy"
    },
    {
      "from": "maxTokens",
      "to": "max_output_tokens",
      "presence": "truthy"
    },
    {
      "from": "temperature",
      "to": "temperature"
    },
    {
      "from": "topP",
      "to": "top_p"
    },
    {
      "from": "seed",
      "to": "seed",
      "when": {
        "flavor": "xai"
      },
      "note": "only the xAI backend accepts seed on this API"
    },
    {
      "from": "serviceTier",
      "to": "service_tier",
      "presence": "truthy",
      "call": "openaiTier"
    }
  ],
  "blocks": [
    {
      "name": "input",
      "call": "openaiResponsesInput",
      "to": "input"
    },
    {
      "name": "moderation",
      "when": {
        "pred": "wantsNativeModeration"
      },
      "to": "moderation",
      "template": {
        "$call": "nativeModeration"
      }
    },
    {
      "_note": "One field, two ways in: the raw passthrough (mode/ttl/breakpoints) and the unified `cacheDiagnostics`. They MERGE -- a caller setting both used to lose whichever block ran second. Measured 2026-09-29 on gpt-5.6-luna: the server echoes the option back with its own mode/ttl defaults filled in, and an unknown comparison id answers 200 with `comparison_response_not_found`.",
      "name": "promptCacheOptions",
      "when": {
        "all": [
          {
            "flavor": "openai"
          },
          {
            "any": [
              {
                "truthy": "providerOptions.promptCacheOptions"
              },
              {
                "defined": "cacheDiagnostics"
              }
            ]
          }
        ]
      },
      "to": "prompt_cache_options",
      "template": {
        "$call": "openaiPromptCacheOptions"
      }
    },
    {
      "name": "tools",
      "when": {
        "truthy": "tools"
      },
      "to": "tools",
      "template": {
        "$map": "tools",
        "$dropUnmatched": true,
        "$case": [
          {
            "when": {
              "isFunctionTool": true
            },
            "value": {
              "type": "function",
              "name": {
                "$": "@name"
              },
              "description": {
                "$": "@description"
              },
              "parameters": {
                "$call": "ensureAdditionalProperties",
                "$arg": {
                  "$": "@parameters"
                }
              },
              "strict": {
                "$call": "openaiResponsesToolStrict",
                "$arg": {
                  "$": "@"
                }
              },
              "allowed_callers": {
                "$when": {
                  "itemTruthy": "allowedCallers"
                },
                "$value": {
                  "$": "@allowedCallers"
                }
              },
              "output_schema": {
                "$when": {
                  "itemTruthy": "outputSchema"
                },
                "$value": {
                  "$": "@outputSchema"
                }
              }
            }
          },
          {
            "value": {
              "type": {
                "$": "@type"
              },
              "container": {
                "$when": {
                  "builtin": "code_interpreter"
                },
                "$value": {
                  "type": "auto"
                }
              },
              "$spread": {
                "$": "@params"
              },
              "$note": "container is declared BEFORE $spread so caller params win, matching today"
            }
          }
        ]
      }
    },
    {
      "name": "toolChoice.keyword",
      "when": {
        "all": [
          {
            "truthy": "toolChoice"
          },
          {
            "pred": "toolChoiceIsString"
          }
        ]
      },
      "to": "tool_choice",
      "template": {
        "$": "toolChoice"
      }
    },
    {
      "name": "toolChoice.named",
      "when": {
        "all": [
          {
            "truthy": "toolChoice"
          },
          {
            "not": {
              "pred": "toolChoiceIsString"
            }
          }
        ]
      },
      "to": "tool_choice",
      "template": {
        "type": "function",
        "name": {
          "$": "toolChoice.name"
        }
      }
    },
    {
      "name": "structured",
      "when": {
        "truthy": "structured"
      },
      "to": "text",
      "template": {
        "format": {
          "type": "json_schema",
          "name": {
            "$": "structured.name",
            "$default": "response"
          },
          "schema": {
            "$call": "openaiResponsesStructuredSchema"
          },
          "strict": {
            "$call": "openaiStructuredStrict"
          }
        }
      }
    },
    {
      "name": "reasoning",
      "when": {
        "all": [
          {
            "truthy": "thinking"
          },
          {
            "ne": [
              "thinking.mode",
              "off"
            ]
          }
        ]
      },
      "to": "reasoning",
      "template": {
        "effort": {
          "$table": "reasoningEffort",
          "$key": "thinking.effort",
          "$default": "medium"
        },
        "summary": {
          "$when": {
            "ne": [
              "thinking.visibility",
              "hidden"
            ]
          },
          "$value": {
            "$table": "summaryByVisibility",
            "$key": "thinking.visibility",
            "$default": "auto"
          }
        },
        "mode": {
          "$when": {
            "truthy": "providerOptions.reasoningMode"
          },
          "$value": {
            "$": "providerOptions.reasoningMode"
          }
        },
        "context": {
          "$when": {
            "truthy": "thinking.context"
          },
          "$value": {
            "$": "thinking.context"
          }
        }
      }
    },
    {
      "_note": "web_search_call.results is omitted from the response unless the request asks for it. Derived from the tools rather than exposed as a knob: a caller who asked for image results has already said what they want, and the two halves arriving separately is how you get a search that found images and a response without them.",
      "name": "include",
      "to": "include",
      "template": {
        "$call": "openaiResponsesInclude"
      }
    }
  ],
  "overlays": {
    "xai": {
      "ops": [
        {
          "op": "call",
          "call": "xaiSystemIntoInput"
        },
        {
          "op": "delete",
          "from": "reasoning",
          "when": {
            "not": {
              "pred": "xaiTakesReasoning"
            }
          }
        },
        {
          "op": "call",
          "call": "xaiServiceTier"
        },
        {
          "op": "call",
          "call": "xaiCodeExecInclude"
        }
      ]
    },
    "openrouter": {
      "ops": [
        {
          "op": "mergeFrom",
          "from": "providerOptions.openrouter"
        }
      ]
    }
  },
  "_note": "Unversioned: no OpenAI chat model varies the wire shape, so there is no chain to pin. Flavor differences (xai, openrouter) are overlays, not versions."
}

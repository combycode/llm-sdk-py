{
  "id": "anthropic/messages.response",
  "_note": "Transposed from AnthropicAdapter.parseResponse, block type for block type. Proven against every recorded anthropic/messages cell in response-golden.json: the spec output must equal the parser output exactly, so this file is checked against real provider bodies rather than against anyone's reading of them.",

  "accumulators": {
    "content": { "kind": "array" },
    "toolCalls": { "kind": "array" },
    "media": { "kind": "array" },
    "files": { "kind": "array", "omitEmpty": true },
    "builtinToolCalls": { "kind": "array", "omitEmpty": true },
    "thinking": { "kind": "scalar", "default": null }
  },

  "fields": [
    { "to": "id", "from": "raw.id" },
    { "to": "model", "from": "raw.model" }
  ],

  "collect": [
    {
      "from": "raw.content",
      "match": "type",
      "cases": {
        "text": {
          "emit": "content",
          "as": { "type": "text", "text": { "$": "@text" } }
        },
        "thinking": {
          "emit": "thinking",
          "mode": "scalar",
          "as": { "$": "@thinking" }
        },
        "tool_use": {
          "_note": "One object into BOTH accumulators, not two equal ones.",
          "emit": ["content", "toolCalls"],
          "as": {
            "type": "tool_call",
            "id": { "$": "@id" },
            "name": { "$": "@name" },
            "arguments": { "$": "@input" }
          }
        },
        "server_tool_use": {
          "emit": "builtinToolCalls",
          "as": { "$call": "anthropicBuiltinCall" }
        }
      },
      "default": [
        {
          "_note": "A *_tool_result attaches its stdout to the server_tool_use it belongs to, matched on tool_use_id. That writes to an object already collected, so it is an effect and not an emit.",
          "effect": "anthropicAttachToolOutput"
        },
        {
          "_note": "One code-execution result block can carry several output files, hence concat.",
          "emit": "files",
          "mode": "concat",
          "as": { "$call": "anthropicCodeExecFiles" }
        }
      ]
    }
  ],

  "derive": {
    "text": { "$call": "anthropicText" },
    "usage": { "$call": "anthropicUsageFull" },
    "finishReason": { "$call": "anthropicFinish" },
    "citations": { "$call": "anthropicCitations" }
  }
}

{
  "id": "google/retrieval.deleteCorpus",
  "extends": "google/retrieval.json",
  "envelope": {
    "method": "DELETE",
    "bodyKind": "none",
    "url": {
      "$join": [
        {
          "$config": "baseURL"
        },
        "/v1beta/",
        {
          "$": "corpusId"
        }
      ]
    },
    "_note": "force cascades to the documents; without it a non-empty store refuses to delete.",
    "query": [
      {
        "name": "force",
        "value": true
      }
    ]
  }
}
